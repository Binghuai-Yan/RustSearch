<UserControl x:Class="RustSearch.UI.Views.Controls.SearchResultItem"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:RustSearch.UI.Views.Controls">
    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="16,14">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock local:HighlightText.Html="{Binding FilenameHl}" FontSize="15" FontWeight="SemiBold"
                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Filename}" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding ExtensionText}" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Grid.Row="1" Text="{Binding Path}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,6,0,0"
                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
            <TextBlock Grid.Row="2" local:HighlightText.Html="{Binding SnippetText}" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                       TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="58" LineHeight="19" Margin="0,8,0,0" />
            <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,8,0,0">
                <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
                <TextBlock Text=" · " Foreground="{DynamicResource TextMutedBrush}" />
                <TextBlock Text="{Binding DateText}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
