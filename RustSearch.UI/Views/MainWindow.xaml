<Window x:Class="RustSearch.UI.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:RustSearch.UI.Views.Controls"
        Title="RustSearch" Width="1160" Height="790" MinWidth="820" MinHeight="550"
        Icon="/Assets/RustSearch.ico" WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="64" />
            <RowDefinition Height="68" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="48" />
            <RowDefinition Height="36" />
        </Grid.RowDefinitions>
        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="/Assets/RustSearch.png" Width="30" Height="30" Margin="0,0,10,0" />
                    <TextBlock Text="RustSearch" FontFamily="Segoe UI" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Margin="0,0,8,0">
                        <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource WarningTextBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsConnected}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentBrush}" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding BackendStatus}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" ToolTip="{Binding BackendStatus}" />
                    <Button Style="{StaticResource IconButton}" ToolTip="重新连接" AutomationProperties.Name="重新连接" Command="{Binding ReconnectCommand}" Margin="12,0,0,0"><controls:IconParkIcon Icon="refresh" IconBrush="{DynamicResource IconBrush}" /></Button>
                    <Button Style="{StaticResource IconButton}" ToolTip="设置" AutomationProperties.Name="设置" Click="Settings_Click" Margin="4,0,0,0"><controls:IconParkIcon Icon="setting" IconBrush="{DynamicResource IconBrush}" /></Button>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24,14,24,12">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="126" /><ColumnDefinition Width="142" /></Grid.ColumnDefinitions>
            <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Background="{DynamicResource WindowBrush}" Margin="0,0,12,0">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="38" /><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /><ColumnDefinition Width="34" /></Grid.ColumnDefinitions>
                    <controls:IconParkIcon Icon="search" IconBrush="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <TextBox x:Name="SearchBox" Grid.Column="1" Text="{Binding Query, UpdateSourceTrigger=PropertyChanged}" FontSize="16" Padding="0,6" Background="Transparent" BorderThickness="0" VerticalContentAlignment="Center" KeyDown="SearchBox_KeyDown" AutomationProperties.Name="搜索" AutomationProperties.AutomationId="SearchQuery" />
                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="30" ToolTip="清空搜索" AutomationProperties.Name="清空搜索" Command="{Binding ClearQueryCommand}"><controls:IconParkIcon Icon="close" IconBrush="{DynamicResource IconBrush}" /></Button>
                    <ToggleButton x:Name="HistoryButton" Grid.Column="3" Width="32" Background="Transparent" BorderThickness="0" ToolTip="搜索历史" AutomationProperties.Name="搜索历史" Command="{Binding LoadHistoryCommand}"><controls:IconParkIcon Icon="history" IconBrush="{DynamicResource IconBrush}" /></ToggleButton>
                    <Popup PlacementTarget="{Binding ElementName=SearchBox}" IsOpen="{Binding IsChecked, ElementName=HistoryButton}" StaysOpen="False" Placement="Bottom" AllowsTransparency="True">
                        <Border Background="{DynamicResource WindowBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Width="400" MaxHeight="300" Padding="8">
                            <StackPanel>
                                <TextBlock Text="最近搜索" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="8,4,0,8" />
                                <ListBox ItemsSource="{Binding History}" SelectionChanged="History_SelectionChanged" BorderThickness="0" MaxHeight="250" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding}" TextTrimming="CharacterEllipsis" Margin="4,6" /></DataTemplate></ListBox.ItemTemplate>
                                </ListBox>
                            </StackPanel>
                        </Border>
                    </Popup>
                </Grid>
            </Border>
            <ComboBox Grid.Column="1" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" Margin="0,0,10,0" VerticalContentAlignment="Center" AutomationProperties.Name="文件类型" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding Sorts}" SelectedItem="{Binding SelectedSort}" VerticalContentAlignment="Center" AutomationProperties.Name="排序方式" />
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource ErrorSurfaceBrush}" Padding="24,8" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" ToolTip="关闭提示" Command="{Binding DismissErrorCommand}"><controls:IconParkIcon Icon="close" IconBrush="{DynamicResource IconBrush}" /></Button>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource ErrorTextBrush}" TextWrapping="Wrap" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
        <ProgressBar Grid.Row="3" Style="{x:Null}" Height="2" IsIndeterminate="True" Visibility="{Binding IsSearching, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource AccentBrush}" />
        <Grid Grid.Row="4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="3*" MinWidth="300" MaxWidth="800" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="2*" MinWidth="280" MaxWidth="700" />
            </Grid.ColumnDefinitions>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                        <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="24,0">
                    <DockPanel>
                        <TextBlock Text="搜索结果" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                        <Button Style="{StaticResource IconButton}" Height="30" HorizontalAlignment="Right" ToolTip="刷新结果" AutomationProperties.Name="刷新结果" Command="{Binding RefreshSearchCommand}"><controls:IconParkIcon Icon="refresh" IconBrush="{DynamicResource IconBrush}" /></Button>
                    </DockPanel>
                </Border>
                <ListBox x:Name="ResultList" Grid.Row="1" ItemsSource="{Binding Results}" SelectedItem="{Binding SelectedResult}" BorderThickness="0" Padding="8,0"
                         HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" MouseDoubleClick="Results_DoubleClick" KeyDown="Results_KeyDown">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" /><Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
                            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="ItemBorder" Background="Transparent"><ContentPresenter /></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource PanelBrush}" /></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="{DynamicResource SelectionBrush}" /></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
                            <Setter Property="ContextMenu"><Setter.Value><ContextMenu DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"><MenuItem Header="打开文件" Command="{Binding OpenFileCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /><MenuItem Header="打开所在文件夹" Command="{Binding OpenFolderCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /><Separator /><MenuItem Header="复制路径" Command="{Binding CopyPathCommand}" CommandParameter="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource AncestorType=ContextMenu}}" /></ContextMenu></Setter.Value></Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate><DataTemplate><controls:SearchResultItem /></DataTemplate></ListBox.ItemTemplate>
                </ListBox>
                <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource BoolVisibility}}" Margin="20">
                    <controls:IconParkIcon Icon="inbox" Width="38" Height="38" IconBrush="{DynamicResource MutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,18" />
                    <TextBlock Text="{Binding EmptyStateTitle}" Foreground="{DynamicResource TextMutedBrush}" FontSize="15" TextAlignment="Center" TextWrapping="Wrap" />
                    <Button Content="添加索引文件夹" Style="{StaticResource PrimaryButton}" Command="{Binding AddRootCommand}" Margin="0,20,0,0" Visibility="{Binding HasNoRoots, Converter={StaticResource BoolVisibility}}" />
                </StackPanel>
            </Grid>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="{DynamicResource BorderBrush}" ShowsPreview="True" ResizeDirection="Columns"
                          ResizeBehavior="PreviousAndNext" Focusable="True" KeyboardNavigation.TabIndex="0"
                          AutomationProperties.Name="调整搜索结果和预览窗格宽度" ToolTip="拖动调整窗格宽度" />
            <Grid Grid.Column="2" Background="{DynamicResource WindowBrush}">
                <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,1" Padding="18,0">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" IsEnabled="{Binding HasSelection}">
                            <Button Style="{StaticResource IconButton}" Height="30" ToolTip="打开文件" AutomationProperties.Name="打开文件" Command="{Binding OpenFileCommand}"><controls:IconParkIcon Icon="file" IconBrush="{DynamicResource IconBrush}" /></Button>
                            <Button Style="{StaticResource IconButton}" Height="30" ToolTip="打开所在文件夹" AutomationProperties.Name="打开所在文件夹" Command="{Binding OpenFolderCommand}"><controls:IconParkIcon Icon="folder" IconBrush="{DynamicResource IconBrush}" /></Button>
                            <Button Style="{StaticResource IconButton}" Height="30" ToolTip="复制路径" AutomationProperties.Name="复制路径" Command="{Binding CopyPathCommand}"><controls:IconParkIcon Icon="copy" IconBrush="{DynamicResource IconBrush}" /></Button>
                        </StackPanel>
                        <TextBlock Text="预览" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    </DockPanel>
                </Border>
                <StackPanel Grid.Row="1" Margin="22,22,22,12">
                    <TextBlock Text="{Binding PreviewTitle}" FontSize="17" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SelectedResult.Path}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding PreviewStatus}" Visibility="{Binding HasPreviewStatus, Converter={StaticResource BoolVisibility}}" Foreground="{DynamicResource WarningTextBrush}" TextWrapping="Wrap" Margin="0,10,0,0" />
                </StackPanel>
                <ProgressBar Grid.Row="2" Style="{x:Null}" Height="2" Margin="22,0" IsIndeterminate="True" Foreground="{DynamicResource AccentBrush}" Visibility="{Binding IsPreviewLoading, Converter={StaticResource BoolVisibility}}" />
                <TextBox Grid.Row="3" Text="{Binding PreviewText, Mode=OneWay}" IsReadOnly="True"
                         Width="1" Height="1" Opacity="0" IsHitTestVisible="False"
                         AutomationProperties.AutomationId="PreviewText" />
                <RichTextBox Grid.Row="3" controls:HighlightText.Html="{Binding PreviewHtml}" IsReadOnly="True"
                             IsDocumentEnabled="False" Background="Transparent" BorderThickness="0"
                             FontSize="13" Foreground="{DynamicResource WindowTextBrush}" Padding="22,6,22,24"
                             VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                             AutomationProperties.Name="文件文本预览" AutomationProperties.AutomationId="PreviewTextRich" />
            </Grid>
        </Grid>
        <Border Grid.Row="5" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding ResultSummary}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" AutomationProperties.AutomationId="ResultSummary" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource IconButton}" ToolTip="上一页" AutomationProperties.Name="上一页" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanPreviousPage}"><controls:IconParkIcon Icon="left" IconBrush="{DynamicResource IconBrush}" /></Button>
                    <TextBlock Text="{Binding PageText}" MinWidth="80" TextAlignment="Center" VerticalAlignment="Center" FontSize="12" AutomationProperties.AutomationId="PageCounter" />
                    <Button Style="{StaticResource IconButton}" ToolTip="下一页" AutomationProperties.Name="下一页" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}"><controls:IconParkIcon Icon="right" IconBrush="{DynamicResource IconBrush}" /></Button>
                </StackPanel>
            </Grid>
        </Border>
        <Border Grid.Row="6" Background="{DynamicResource PanelBrush}" Padding="24,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <TextBlock Text="{Binding StatsText}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextTrimming="CharacterEllipsis" />
                <ProgressBar Grid.Column="1" Style="{x:Null}" Width="80" Height="4" Value="{Binding IndexProgress}" Foreground="{DynamicResource AccentBrush}" Margin="12,0" VerticalAlignment="Center" Visibility="{Binding IsIndexing, Converter={StaticResource BoolVisibility}}" AutomationProperties.AutomationId="IndexProgressBar" />
                <TextBlock Grid.Column="2" Text="{Binding ProgressText}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="11" MaxWidth="260" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>
    </Grid>
</Window>
