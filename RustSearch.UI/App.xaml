<Application x:Class="RustSearch.UI.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/SkinDefault.xaml" />
                <ResourceDictionary Source="pack://application:,,,/HandyControl;component/Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AccentBrush" Color="#16795C" />
            <SolidColorBrush x:Key="MutedBrush" Color="#64716D" />
            <SolidColorBrush x:Key="TextMutedBrush" Color="#78867C" />
            <SolidColorBrush x:Key="TextSecondaryBrush" Color="#48564D" />
            <SolidColorBrush x:Key="TextTertiaryBrush" Color="#718076" />
            <SolidColorBrush x:Key="IconBrush" Color="#43534B" />
            <SolidColorBrush x:Key="WindowBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="WindowTextBrush" Color="#202924" />
            <SolidColorBrush x:Key="PanelBrush" Color="#F5F8F5" />
            <SolidColorBrush x:Key="BorderBrush" Color="#E4EAE5" />
            <SolidColorBrush x:Key="SurfaceAltBrush" Color="#F1F5F1" />
            <SolidColorBrush x:Key="InputBrush" Color="#FCFEFC" />
            <SolidColorBrush x:Key="SelectionBrush" Color="#EDF5EF" />
            <SolidColorBrush x:Key="ErrorSurfaceBrush" Color="#FEF2EE" />
            <SolidColorBrush x:Key="ErrorTextBrush" Color="#A84732" />
            <SolidColorBrush x:Key="WarningTextBrush" Color="#976A27" />
            <BooleanToVisibilityConverter x:Key="BoolVisibility" />
            <Style TargetType="Window">
                <Setter Property="FontFamily" Value="Microsoft YaHei UI" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource WindowTextBrush}" />
                <Setter Property="Background" Value="{DynamicResource WindowBrush}" />
            </Style>
            <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="Foreground" Value="{DynamicResource IconBrush}" />
            </Style>
            <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="MinHeight" Value="36" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
