<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\RustSearch.ico</ApplicationIcon>
    <AssemblyName>RustSearch.UI</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="../frontends.json" LogicalName="RustSearch.Frontends" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="HandyControl" Version="3.5.1" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
    <Resource Include="Assets\RustSearch.ico" />
    <Resource Include="Assets\RustSearch.png" />
  </ItemGroup>
</Project>
