{
  "name": "rustsearch-tauri",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "tauri": "tauri",
    "desktop": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1",
    "desktop:build": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 -Release",
    "test": "vitest run",
    "test:desktop": "node tests/desktop.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.10.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "lucide-vue-next": "^0.468.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tauri-apps/cli": "^2.12.2",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.3.0",
    "vitest": "^3.2.0",
    "vue-tsc": "^3.1.0"
  }
}
