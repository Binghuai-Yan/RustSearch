<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="WorkspaceBrush" Color="#F8F8F8"/>
      <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="RailSelectionBrush" Color="#10000000"/>
      <SolidColorBrush x:Key="DividerBrush" Color="#14000000"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#99000000"/>
      <SolidColorBrush x:Key="ShellFallbackBrush" Color="#F3F3F3"/>
      <SolidColorBrush x:Key="SearchSurfaceBrush" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="HoverBrush" Color="#09000000"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="WorkspaceBrush" Color="#202020"/>
      <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="#272727"/>
      <SolidColorBrush x:Key="RailSelectionBrush" Color="#14FFFFFF"/>
      <SolidColorBrush x:Key="DividerBrush" Color="#1FFFFFFF"/>
      <SolidColorBrush x:Key="MutedBrush" Color="#ABFFFFFF"/>
      <SolidColorBrush x:Key="ShellFallbackBrush" Color="#202020"/>
      <SolidColorBrush x:Key="SearchSurfaceBrush" Color="#333333"/>
      <SolidColorBrush x:Key="HoverBrush" Color="#0FFFFFFF"/>
    </ResourceDictionary>
    <ResourceDictionary x:Key="HighContrast">
      <SolidColorBrush x:Key="WorkspaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="PreviewSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="RailSelectionBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
      <SolidColorBrush x:Key="DividerBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="MutedBrush" Color="{ThemeResource SystemColorWindowTextColor}"/>
      <SolidColorBrush x:Key="ShellFallbackBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="SearchSurfaceBrush" Color="{ThemeResource SystemColorWindowColor}"/>
      <SolidColorBrush x:Key="HoverBrush" Color="{ThemeResource SystemColorHighlightColor}"/>
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <Style x:Key="PageTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="24"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CharacterSpacing" Value="0"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
  </Style>
  <Style x:Key="SectionTitleStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="SemiBold"/>
    <Setter Property="CharacterSpacing" Value="0"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
  </Style>
  <Style x:Key="CaptionTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="12"/>
    <Setter Property="CharacterSpacing" Value="0"/>
    <Setter Property="Foreground" Value="{ThemeResource MutedBrush}"/>
  </Style>
  <Style x:Key="BodyTextStyle" TargetType="TextBlock">
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="CharacterSpacing" Value="0"/>
    <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}"/>
  </Style>
  <Style x:Key="SubtleToolButtonStyle" TargetType="Button">
    <Setter Property="Width" Value="32"/>
    <Setter Property="Height" Value="32"/>
    <Setter Property="MinWidth" Value="0"/>
    <Setter Property="MinHeight" Value="0"/>
    <Setter Property="Padding" Value="6"/>
    <Setter Property="CornerRadius" Value="4"/>
    <Setter Property="BorderThickness" Value="0"/>
    <Setter Property="BorderBrush" Value="Transparent"/>
    <Setter Property="Background" Value="Transparent"/>
    <Setter Property="HorizontalContentAlignment" Value="Center"/>
    <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style x:Key="StandardToolButtonStyle" TargetType="Button" BasedOn="{StaticResource SubtleToolButtonStyle}">
    <Setter Property="Background" Value="{ThemeResource SearchSurfaceBrush}"/>
    <Setter Property="BorderBrush" Value="{ThemeResource DividerBrush}"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Padding" Value="5"/>
  </Style>
</ResourceDictionary>
