<Window x:Class="RustSearch.WinUI.SettingsWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RustSearch.WinUI">
  <Grid x:Name="Root" Background="Transparent">
    <Grid.RowDefinitions><RowDefinition Height="48" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <Grid x:Name="TitleDragRegion" Background="Transparent" Height="48" AutomationProperties.AutomationId="WindowDragRegion" AutomationProperties.Name="窗口标题栏" AutomationProperties.AccessibilityView="Content">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
      <local:IconParkIcon Kind="search" Width="18" Height="18" Margin="20,0,10,0" />
      <TextBlock Grid.Column="1" Text="RustSearch · 设置" VerticalAlignment="Center" FontSize="13" />
      <Border x:Name="CaptionInset" Grid.Column="2" />
    </Grid>
    <NavigationView x:Name="SettingsNavigation" Grid.Row="1" PaneDisplayMode="Left"
        OpenPaneLength="192" CompactPaneLength="48" IsPaneOpen="True" IsPaneToggleButtonVisible="False"
        IsSettingsVisible="False" IsBackButtonVisible="Collapsed" AlwaysShowHeader="False"
        SelectionChanged="SettingsNavigation_SelectionChanged" AutomationProperties.AutomationId="SettingsNavigation">
      <NavigationView.MenuItems>
        <NavigationViewItem x:Name="NavIndex" Content="索引文件夹" Tag="index" AutomationProperties.AutomationId="SettingsNavIndex" />
        <NavigationViewItem x:Name="NavOptions" Content="索引选项" Tag="options" AutomationProperties.AutomationId="SettingsNavOptions" />
        <NavigationViewItem x:Name="NavAppearance" Content="外观与行为" Tag="appearance" AutomationProperties.AutomationId="SettingsNavAppearance" />
        <NavigationViewItem x:Name="NavStorage" Content="数据存储" Tag="storage" AutomationProperties.AutomationId="SettingsNavStorage" />
      </NavigationView.MenuItems>
      <NavigationView.FooterMenuItems>
        <NavigationViewItem x:Name="NavAbout" Content="关于" Tag="about" AutomationProperties.AutomationId="SettingsNavAbout" />
      </NavigationView.FooterMenuItems>
      <Grid Background="{ThemeResource WorkspaceBrush}">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer x:Name="SettingsScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
            AutomationProperties.AutomationId="SettingsScroll">
          <Grid x:Name="SettingsContent" Margin="28,24,28,24">
            <Grid x:Name="IndexPage">
              <StackPanel Spacing="20">
                <TextBlock Text="索引文件夹" Style="{StaticResource PageTitleStyle}" />
                <TextBlock x:Name="StatisticsText" TextWrapping="Wrap" Foreground="{ThemeResource MutedBrush}"
                    AutomationProperties.AutomationId="SettingsStatistics" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="RootPathBox" Header="添加文件夹" PlaceholderText="文件夹路径" MinWidth="0"
                      AutomationProperties.AutomationId="SettingsRootPath" AutomationProperties.Name="索引文件夹路径" />
                  <Button Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource StandardToolButtonStyle}" Click="BrowseRoot_Click"
                      ToolTipService.ToolTip="选择索引文件夹" AutomationProperties.Name="选择索引文件夹" AutomationProperties.AutomationId="SettingsBrowseRoot">
                    <local:IconParkIcon Kind="folder-open" Width="18" Height="18" />
                  </Button>
                  <Button Grid.Column="2" Height="32" VerticalAlignment="Bottom" Click="AddRoot_Click" AutomationProperties.AutomationId="SettingsAddRoot">
                    <StackPanel Orientation="Horizontal" Spacing="6"><local:IconParkIcon Kind="folder-plus" Width="16" Height="16" /><TextBlock Text="添加" /></StackPanel>
                  </Button>
                </Grid>
                <ListView x:Name="RootsList" Height="240" SelectionMode="Single" SelectionChanged="RootsList_SelectionChanged"
                    Background="{ThemeResource PreviewSurfaceBrush}" BorderThickness="1" BorderBrush="{ThemeResource DividerBrush}"
                    AutomationProperties.AutomationId="SettingsRoots">
                  <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="MinHeight" Value="44" /></Style>
                  </ListView.ItemContainerStyle>
                  <ListView.ItemTemplate>
                    <DataTemplate>
                      <Grid ColumnSpacing="12">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <local:IconParkIcon Kind="folder" Width="18" Height="18" />
                        <TextBlock Grid.Column="1" Text="{Binding Path}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" ToolTipService.ToolTip="{Binding Path}" />
                        <TextBlock Grid.Column="2" Text="{Binding TotalDocs}" Foreground="{ThemeResource MutedBrush}" VerticalAlignment="Center" />
                      </Grid>
                    </DataTemplate>
                  </ListView.ItemTemplate>
                </ListView>
                <Grid ColumnSpacing="12">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Button x:Name="RemoveRootButton" Style="{StaticResource SubtleToolButtonStyle}" Click="RemoveRoot_Click" IsEnabled="False"
                        ToolTipService.ToolTip="移除索引文件夹" AutomationProperties.Name="移除索引文件夹" AutomationProperties.AutomationId="SettingsRemoveRoot">
                      <local:IconParkIcon Kind="delete" Width="18" Height="18" />
                    </Button>
                    <Button x:Name="RebuildRootButton" Style="{StaticResource SubtleToolButtonStyle}" Click="RebuildRoot_Click" IsEnabled="False"
                        ToolTipService.ToolTip="重建所选文件夹索引" AutomationProperties.Name="重建所选文件夹索引" AutomationProperties.AutomationId="SettingsRebuildRoot">
                      <local:IconParkIcon Kind="refresh" Width="18" Height="18" />
                    </Button>
                  </StackPanel>
                  <TextBlock x:Name="IndexStateText" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap"
                      Foreground="{ThemeResource MutedBrush}" AutomationProperties.AutomationId="SettingsIndexState" />
                  <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4">
                    <Button x:Name="PauseButton" Style="{StaticResource SubtleToolButtonStyle}" Click="Pause_Click"
                        ToolTipService.ToolTip="暂停索引" AutomationProperties.Name="暂停索引" AutomationProperties.AutomationId="SettingsPause">
                      <local:IconParkIcon x:Name="PauseIcon" Kind="pause" Width="18" Height="18" />
                    </Button>
                    <Button Style="{StaticResource SubtleToolButtonStyle}" Click="Refresh_Click"
                        ToolTipService.ToolTip="刷新统计" AutomationProperties.Name="刷新统计" AutomationProperties.AutomationId="SettingsRefresh">
                      <local:IconParkIcon Kind="refresh" Width="18" Height="18" />
                    </Button>
                  </StackPanel>
                </Grid>
              </StackPanel>
            </Grid>
            <Grid x:Name="OptionsPage" Visibility="Collapsed">
              <StackPanel Spacing="24">
                <TextBlock Text="索引选项" Style="{StaticResource PageTitleStyle}" />
                <Grid ColumnSpacing="20" Padding="0,0,0,20" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerBrush}">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                  <StackPanel VerticalAlignment="Center" Spacing="4">
                    <TextBlock Text="单文件大小上限" Style="{StaticResource SectionTitleStyle}" />
                    <TextBlock Text="1-2048 MB" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource MutedBrush}" />
                  </StackPanel>
                  <NumberBox x:Name="MaxFileSizeBox" Grid.Column="1" Minimum="1" Maximum="2048" Value="200"
                      SmallChange="10" LargeChange="100" SpinButtonPlacementMode="Inline" VerticalAlignment="Center"
                      AutomationProperties.Name="单文件大小上限（MB）" AutomationProperties.AutomationId="SettingsMaxFileSize" />
                </Grid>
                <TextBox x:Name="SkipDirectoriesBox" Header="忽略目录" AcceptsReturn="True" Height="132" TextWrapping="Wrap"
                    ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="SettingsSkipDirectories" />
                <Border Height="1" Background="{ThemeResource DividerBrush}" />
                <StackPanel Spacing="8">
                  <TextBox x:Name="DictionaryBox" Header="自定义分词词典" AcceptsReturn="True" Height="196" TextWrapping="Wrap"
                      ScrollViewer.VerticalScrollBarVisibility="Auto" AutomationProperties.AutomationId="SettingsDictionary" />
                  <TextBlock Text="最大 1 MB" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource MutedBrush}" />
                </StackPanel>
              </StackPanel>
            </Grid>
            <Grid x:Name="AppearancePage" Visibility="Collapsed">
              <StackPanel Spacing="24">
                <TextBlock Text="外观与行为" Style="{StaticResource PageTitleStyle}" />
                <Grid ColumnSpacing="24" MinHeight="72" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerBrush}" Padding="0,0,0,20">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="180" /></Grid.ColumnDefinitions>
                  <TextBlock Text="界面主题" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" />
                  <ComboBox x:Name="ThemeBox" Grid.Column="1" HorizontalAlignment="Stretch" VerticalAlignment="Center"
                      SelectionChanged="Theme_SelectionChanged" AutomationProperties.Name="界面主题" AutomationProperties.AutomationId="SettingsTheme">
                    <ComboBoxItem Content="浅色" Tag="Light" /><ComboBoxItem Content="深色" Tag="Dark" />
                  </ComboBox>
                </Grid>
                <Grid ColumnSpacing="24" MinHeight="72" BorderThickness="0,0,0,1" BorderBrush="{ThemeResource DividerBrush}" Padding="0,0,0,20">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="220" /></Grid.ColumnDefinitions>
                  <TextBlock Text="关闭主窗口时" Style="{StaticResource SectionTitleStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                  <ToggleSwitch x:Name="CloseToTraySwitch" Grid.Column="1" OnContent="最小化到系统托盘" OffContent="完全退出"
                      Toggled="CloseToTray_Toggled" VerticalAlignment="Center" AutomationProperties.Name="关闭主窗口时" AutomationProperties.AutomationId="SettingsCloseToTray" />
                </Grid>
              </StackPanel>
            </Grid>
            <Grid x:Name="StoragePage" Visibility="Collapsed">
              <StackPanel Spacing="24">
                <TextBlock Text="数据存储" Style="{StaticResource PageTitleStyle}" />
                <StackPanel Spacing="12">
                  <TextBlock Text="当前数据文件夹" Style="{StaticResource SectionTitleStyle}" />
                  <TextBlock x:Name="CurrentDataDirectoryText" TextWrapping="Wrap" IsTextSelectionEnabled="True"
                      Foreground="{ThemeResource MutedBrush}" AutomationProperties.AutomationId="SettingsCurrentDataDirectory" />
                </StackPanel>
                <Border Height="1" Background="{ThemeResource DividerBrush}" />
                <Grid ColumnSpacing="8">
                  <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="32" /></Grid.ColumnDefinitions>
                  <TextBox x:Name="DataDirectoryBox" Header="切换到" PlaceholderText="数据文件夹路径" MinWidth="0"
                      AutomationProperties.AutomationId="SettingsDataDirectory" AutomationProperties.Name="数据文件夹路径" />
                  <Button Grid.Column="1" VerticalAlignment="Bottom" Style="{StaticResource StandardToolButtonStyle}" Click="BrowseDataDirectory_Click"
                      ToolTipService.ToolTip="选择数据文件夹" AutomationProperties.Name="选择数据文件夹" AutomationProperties.AutomationId="SettingsBrowseDataDirectory">
                    <local:IconParkIcon Kind="folder-open" Width="18" Height="18" />
                  </Button>
                </Grid>
                <StackPanel Spacing="8">
                  <CheckBox x:Name="MigrateDataCheckBox" IsChecked="True" Content="迁移当前索引和设置（推荐）"
                      AutomationProperties.AutomationId="SettingsMigrateData" />
                  <TextBlock Text="迁移到空文件夹，保留原目录作为备份。索引、搜索历史、词典和已保存的设置会一起迁移。取消勾选时，直接使用目标目录中的数据。"
                      TextWrapping="Wrap" Style="{StaticResource CaptionTextStyle}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Button Height="32" Click="ChangeDataDirectory_Click" AutomationProperties.AutomationId="SettingsChangeDataDirectory">
                    <StackPanel Orientation="Horizontal" Spacing="6"><local:IconParkIcon Kind="refresh" Width="16" Height="16" /><TextBlock Text="应用更改" /></StackPanel>
                  </Button>
                  <Button Style="{StaticResource SubtleToolButtonStyle}" Click="OpenDataDirectory_Click"
                      ToolTipService.ToolTip="打开当前数据文件夹" AutomationProperties.Name="打开当前数据文件夹" AutomationProperties.AutomationId="SettingsOpenDataDirectory">
                    <local:IconParkIcon Kind="folder-open" Width="18" Height="18" />
                  </Button>
                </StackPanel>
              </StackPanel>
            </Grid>
            <Grid x:Name="AboutPage" Visibility="Collapsed">
              <StackPanel Spacing="24">
                <TextBlock Text="关于" Style="{StaticResource PageTitleStyle}" />
                <StackPanel Spacing="8">
                  <TextBlock x:Name="VersionText" Text="RustSearch" Style="{StaticResource SectionTitleStyle}" AutomationProperties.AutomationId="SettingsVersion" />
                  <TextBlock Text="Windows 本地全文搜索" Foreground="{ThemeResource MutedBrush}" />
                </StackPanel>
                <Border Height="1" Background="{ThemeResource DividerBrush}" />
                <TextBlock Text="IconPark 1.4.2 · Apache License 2.0" Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource MutedBrush}" />
              </StackPanel>
            </Grid>
          </Grid>
        </ScrollViewer>
        <Border Grid.Row="1" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerBrush}" MinHeight="60" Padding="28,12">
          <Grid ColumnSpacing="16" RowSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <Grid.RowDefinitions><RowDefinition Height="Auto" MinHeight="32" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" MaxLines="3" VerticalAlignment="Center"
                Style="{StaticResource CaptionTextStyle}" Foreground="{ThemeResource MutedBrush}" AutomationProperties.AutomationId="SettingsStatus" />
            <Button x:Name="SaveButton" Grid.Column="1" Height="32" Click="Save_Click" Style="{StaticResource AccentButtonStyle}"
                Visibility="Collapsed" AutomationProperties.AutomationId="SettingsSave">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:IconParkIcon Kind="save" Width="16" Height="16" /><TextBlock Text="保存设置" /></StackPanel>
            </Button>
            <Button x:Name="CancelMigrationButton" Grid.Column="1" Height="32" Click="CancelMigration_Click"
                Visibility="Collapsed" AutomationProperties.AutomationId="SettingsCancelMigration">
              <StackPanel Orientation="Horizontal" Spacing="6"><local:IconParkIcon Kind="close" Width="16" Height="16" /><TextBlock Text="取消迁移" /></StackPanel>
            </Button>
            <ProgressBar x:Name="BusyProgress" Grid.Row="1" Grid.ColumnSpan="2" IsIndeterminate="True" Visibility="Collapsed" />
          </Grid>
        </Border>
      </Grid>
    </NavigationView>
  </Grid>
</Window>
