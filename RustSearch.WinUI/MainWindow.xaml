<Window x:Class="RustSearch.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RustSearch.WinUI">
  <Grid x:Name="Root" Background="Transparent">
    <Grid.Resources>
      <Style x:Key="PaneSplitterStyle" TargetType="Thumb">
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="Thumb">
              <Grid Background="Transparent">
                <VisualStateManager.VisualStateGroups>
                  <VisualStateGroup x:Name="CommonStates">
                    <VisualState x:Name="Normal"/>
                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="Grip.Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/><Setter Target="Grip.Width" Value="3"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="Grip.Background" Value="{ThemeResource AccentFillColorDefaultBrush}"/><Setter Target="Grip.Width" Value="3"/></VisualState.Setters></VisualState>
                    <VisualState x:Name="Disabled"/>
                  </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border x:Name="Grip" Width="1" Background="{ThemeResource DividerBrush}" HorizontalAlignment="Center"/>
              </Grid>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </Grid.Resources>
    <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Grid x:Name="TitleDragRegion" Background="Transparent" AutomationProperties.AutomationId="WindowDragRegion" AutomationProperties.Name="窗口标题栏" AutomationProperties.AccessibilityView="Content">
        <StackPanel Orientation="Horizontal" Spacing="10" Margin="20,0,0,0" VerticalAlignment="Center">
          <Image Source="ms-appx:///Assets/RustSearch.png" Width="20" Height="20"/>
          <TextBlock Text="RustSearch" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
        </StackPanel>
      </Grid>
      <Border x:Name="CaptionInset" Grid.Column="1"/>
    </Grid>
    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid Padding="12,16,12,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Spacing="12">
          <Button Style="{StaticResource SubtleToolButtonStyle}" Background="{ThemeResource RailSelectionBrush}" Click="FocusSearch_Click" ToolTipService.ToolTip="搜索" AutomationProperties.Name="搜索" AutomationProperties.AutomationId="SearchNavigation"><local:IconParkIcon Kind="search" Width="18" Height="18"/></Button>
          <Button x:Name="HistoryButton" Style="{StaticResource SubtleToolButtonStyle}" Click="History_Click" ToolTipService.ToolTip="搜索历史" AutomationProperties.Name="搜索历史" AutomationProperties.AutomationId="HistoryButton"><local:IconParkIcon Kind="history" Width="18" Height="18"/></Button>
          <Button Style="{StaticResource SubtleToolButtonStyle}" Click="AddRoot_Click" ToolTipService.ToolTip="索引文件夹" AutomationProperties.Name="索引文件夹" AutomationProperties.AutomationId="AddRootButton"><local:IconParkIcon Kind="folder-plus" Width="18" Height="18"/></Button>
        </StackPanel>
        <StackPanel Grid.Row="2" Spacing="10">
          <Button Style="{StaticResource SubtleToolButtonStyle}" Click="Theme_Click" ToolTipService.ToolTip="切换浅色 / 深色" AutomationProperties.Name="切换主题" AutomationProperties.AutomationId="ThemeButton"><local:IconParkIcon x:Name="ThemeIcon" Kind="moon" Width="18" Height="18"/></Button>
          <Button Style="{StaticResource SubtleToolButtonStyle}" Click="Settings_Click" ToolTipService.ToolTip="设置" AutomationProperties.Name="设置" AutomationProperties.AutomationId="SettingsButton"><local:IconParkIcon Kind="setting" Width="18" Height="18"/></Button>
          <Border Height="1" Background="{ThemeResource DividerBrush}" Margin="4,2"/>
          <Button Style="{StaticResource SubtleToolButtonStyle}" Click="Exit_Click" ToolTipService.ToolTip="完全退出" AutomationProperties.Name="完全退出" AutomationProperties.AutomationId="ExitButton"><local:IconParkIcon Kind="logout" Width="18" Height="18"/></Button>
        </StackPanel>
      </Grid>
      <Grid Grid.Column="1" Background="{ThemeResource WorkspaceBrush}">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
          <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Padding="24,20,24,12" RowSpacing="12">
          <Grid.RowDefinitions><RowDefinition Height="44"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid>
            <local:SearchTextBox x:Name="QueryBox" FontSize="16" Padding="44,9,74,9" PlaceholderText="搜索文件内容、文件名..." TextChanged="QueryBox_TextChanged" KeyDown="QueryBox_KeyDown" AutomationProperties.AutomationId="SearchQuery" Background="{ThemeResource SearchSurfaceBrush}" CornerRadius="6"/>
            <Button Style="{StaticResource SubtleToolButtonStyle}" Margin="6,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Click="Search_Click" ToolTipService.ToolTip="搜索" AutomationProperties.Name="搜索" AutomationProperties.AutomationId="SearchButton"><local:IconParkIcon Kind="search" Width="18" Height="18"/></Button>
            <Button x:Name="ClearButton" Style="{StaticResource SubtleToolButtonStyle}" Margin="0,0,34,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Clear_Click" Visibility="Collapsed" ToolTipService.ToolTip="清空搜索" AutomationProperties.Name="清空搜索" AutomationProperties.AutomationId="ClearButton"><local:IconParkIcon Kind="close" Width="16" Height="16"/></Button>
            <ProgressRing x:Name="SearchActivity" Width="16" Height="16" Margin="0,0,12,0" HorizontalAlignment="Right" VerticalAlignment="Center" IsActive="False" Visibility="Collapsed" IsHitTestVisible="False"/>
          </Grid>
          <Grid Grid.Row="1" ColumnSpacing="8">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <ComboBox x:Name="TypeFilter" Width="130" MinHeight="32" FontSize="13" SelectionChanged="Filter_Changed" AutomationProperties.Name="文件类型" AutomationProperties.AutomationId="TypeFilter"/>
            <ComboBox x:Name="SortFilter" Grid.Column="1" Width="146" MinHeight="32" FontSize="13" SelectionChanged="Filter_Changed" AutomationProperties.Name="排序" AutomationProperties.AutomationId="SortFilter"/>
            <TextBlock x:Name="StatusText" Grid.Column="2" Margin="8,0,0,0" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="BackendStatus"/>
            <Button Grid.Column="3" Style="{StaticResource SubtleToolButtonStyle}" Click="Refresh_Click" ToolTipService.ToolTip="刷新结果" AutomationProperties.Name="刷新结果" AutomationProperties.AutomationId="RefreshButton"><local:IconParkIcon Kind="refresh" Width="16" Height="16"/></Button>
          </Grid>
        </Grid>
        <InfoBar x:Name="ErrorBar" Grid.Row="1" Margin="24,0,24,8" Severity="Error" IsOpen="False" IsClosable="True" AutomationProperties.AutomationId="ErrorMessage"/>
        <Grid x:Name="Panes" Grid.Row="2" SizeChanged="Panes_SizeChanged" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,1">
          <Grid.ColumnDefinitions><ColumnDefinition x:Name="ResultsColumn" Width="1*" MinWidth="240"/><ColumnDefinition Width="8"/><ColumnDefinition x:Name="PreviewColumn" Width="1*" MinWidth="260"/></Grid.ColumnDefinitions>
          <Grid Padding="8,8,0,8">
            <ListView x:Name="ResultsList" SelectionChanged="ResultsList_SelectionChanged" DoubleTapped="ResultsList_DoubleTapped" RightTapped="ResultsList_RightTapped" KeyDown="ResultsList_KeyDown" AutomationProperties.AutomationId="SearchResults" HorizontalContentAlignment="Stretch" SelectionMode="Single">
              <ListView.ItemContainerStyle><Style TargetType="ListViewItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,2"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/></Style></ListView.ItemContainerStyle>
              <ListView.ItemTemplate>
                <DataTemplate>
                  <Grid Padding="12,10" RowSpacing="5" ColumnSpacing="8">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="20"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <local:IconParkIcon Kind="file" Width="18" Height="18"/>
                    <TextBlock Grid.Column="1" local:HighlightText.Html="{Binding FilenameHl}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Grid.Column="2" Text="{Binding ExtensionText}" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center"/>
                    <TextBlock Grid.Row="1" Grid.ColumnSpan="3" local:HighlightText.Html="{Binding SnippetText}" FontSize="13" LineHeight="19" TextWrapping="Wrap" MaxLines="2"/>
                    <Grid Grid.Row="2" Grid.ColumnSpan="3" ColumnSpacing="8">
                      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                      <TextBlock Text="{Binding Path}" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{Binding Path}"/>
                      <TextBlock Grid.Column="1" Text="{Binding SizeText}" Style="{StaticResource CaptionTextStyle}"/>
                    </Grid>
                  </Grid>
                </DataTemplate>
              </ListView.ItemTemplate>
            </ListView>
            <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16" MaxWidth="240" Margin="20">
              <local:IconParkIcon Kind="inbox" Width="40" Height="40" Opacity="0.55"/>
              <TextBlock x:Name="EmptyText" Text="正在读取索引" FontSize="16" TextWrapping="Wrap" TextAlignment="Center"/>
              <Button x:Name="FirstFolderButton" Click="AddRoot_Click" HorizontalAlignment="Center" Visibility="Collapsed" AutomationProperties.AutomationId="FirstFolderButton"><StackPanel Orientation="Horizontal" Spacing="8"><local:IconParkIcon Kind="folder-plus" Width="18" Height="18"/><TextBlock Text="添加索引文件夹"/></StackPanel></Button>
            </StackPanel>
          </Grid>
          <local:ResizeCursorSurface Grid.Column="1" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
            <Thumb x:Name="PaneSplitter" Style="{StaticResource PaneSplitterStyle}" DragStarted="Splitter_DragStarted" DragDelta="Splitter_DragDelta" DragCompleted="Splitter_DragCompleted" KeyDown="Splitter_KeyDown" IsTabStop="True" UseSystemFocusVisuals="True" AutomationProperties.Name="调整结果和预览宽度" AutomationProperties.AutomationId="PaneSplitter" ToolTipService.ToolTip="调整窗格宽度"/>
          </local:ResizeCursorSurface>
          <Grid Grid.Column="2" Background="{ThemeResource PreviewSurfaceBrush}">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Padding="24,20,24,16" RowSpacing="10">
              <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
              <TextBlock x:Name="PreviewTitle" Text="文件预览" Style="{StaticResource SectionTitleStyle}" TextTrimming="CharacterEllipsis"/>
              <TextBlock x:Name="PreviewMetadata" Grid.Row="1" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap"/>
              <ContentControl x:Name="FileActions" Grid.Row="2" IsEnabled="False" HorizontalContentAlignment="Left"><StackPanel Orientation="Horizontal" Spacing="4">
                <Button Style="{StaticResource SubtleToolButtonStyle}" Click="OpenFile_Click" ToolTipService.ToolTip="打开文件" AutomationProperties.Name="打开文件" AutomationProperties.AutomationId="OpenFileButton"><local:IconParkIcon Kind="file" Width="18" Height="18"/></Button>
                <Button Style="{StaticResource SubtleToolButtonStyle}" Click="OpenFolder_Click" ToolTipService.ToolTip="打开所在文件夹" AutomationProperties.Name="打开所在文件夹" AutomationProperties.AutomationId="OpenFolderButton"><local:IconParkIcon Kind="folder-open" Width="18" Height="18"/></Button>
                <Button Style="{StaticResource SubtleToolButtonStyle}" Click="CopyPath_Click" ToolTipService.ToolTip="复制路径" AutomationProperties.Name="复制路径" AutomationProperties.AutomationId="CopyPathButton"><local:IconParkIcon Kind="copy" Width="18" Height="18"/></Button>
              </StackPanel></ContentControl>
            </Grid>
            <TextBlock x:Name="PreviewStatus" Grid.Row="1" Margin="24,0,24,12" Style="{StaticResource CaptionTextStyle}" TextWrapping="Wrap" Visibility="Collapsed" AutomationProperties.AutomationId="PreviewStatus"/>
            <Grid Grid.Row="2" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
              <ScrollViewer x:Name="PreviewScroller" Padding="24,20,24,24" HorizontalScrollBarVisibility="Disabled"><TextBlock x:Name="PreviewText" FontSize="14" LineHeight="24" TextWrapping="Wrap" IsTextSelectionEnabled="True" AutomationProperties.AutomationId="PreviewText"/></ScrollViewer>
              <StackPanel x:Name="PreviewEmptyState" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
                <local:IconParkIcon Kind="file" Width="32" Height="32" Opacity="0.4"/>
                <TextBlock Text="未选择文件" Style="{StaticResource CaptionTextStyle}"/>
              </StackPanel>
            </Grid>
          </Grid>
        </Grid>
        <Grid Grid.Row="3" Padding="16,8">
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="8">
            <Button x:Name="PreviousButton" Style="{StaticResource SubtleToolButtonStyle}" IsEnabled="False" Click="Previous_Click" ToolTipService.ToolTip="上一页" AutomationProperties.Name="上一页" AutomationProperties.AutomationId="PreviousPage"><local:IconParkIcon Kind="left" Width="16" Height="16"/></Button>
            <TextBlock x:Name="PageText" Text="1 / 1" FontSize="12" MinWidth="64" TextAlignment="Center" VerticalAlignment="Center" AutomationProperties.AutomationId="PageText"/>
            <Button x:Name="NextButton" Style="{StaticResource SubtleToolButtonStyle}" IsEnabled="False" Click="Next_Click" ToolTipService.ToolTip="下一页" AutomationProperties.Name="下一页" AutomationProperties.AutomationId="NextPage"><local:IconParkIcon Kind="right" Width="16" Height="16"/></Button>
          </StackPanel>
        </Grid>
        <Grid Grid.Row="4" Padding="16,6,12,6" ColumnSpacing="12" RowSpacing="4" BorderBrush="{ThemeResource DividerBrush}" BorderThickness="0,1,0,0">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
          <TextBlock x:Name="StatsText" Text="正在读取索引" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="IndexStatistics"/>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
            <TextBlock x:Name="ConnectionText" Text="后端连接中" MaxWidth="180" Style="{StaticResource CaptionTextStyle}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" AutomationProperties.AutomationId="BackendConnection"/>
            <Button Style="{StaticResource SubtleToolButtonStyle}" Click="Reconnect_Click" ToolTipService.ToolTip="重新连接" AutomationProperties.Name="重新连接" AutomationProperties.AutomationId="ReconnectButton"><local:IconParkIcon Kind="refresh" Width="14" Height="14"/></Button>
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="4"><TextBlock x:Name="ProgressText" Style="{StaticResource CaptionTextStyle}" TextTrimming="CharacterEllipsis" Visibility="Collapsed" AutomationProperties.AutomationId="IndexProgress"/><ProgressBar x:Name="IndexProgress" Height="2" Visibility="Collapsed"/></StackPanel>
        </Grid>
      </Grid>
    </Grid>
  </Grid>
</Window>
